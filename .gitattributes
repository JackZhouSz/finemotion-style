# Preserve reproducible script hashes across Windows/Linux checkouts.
* text=auto eol=lf

# Example hashes describe exact distributed bytes, including original BVH.
examples/** -text whitespace=cr-at-eol
# Retain original BVH spacing as well as exact bytes.
*.bvh -whitespace
*.gif -text
*.png -text
*.mp4 -text

# Historical snapshots retain their original trailing blank lines and hashes.
scripts/text/historical/*.py whitespace=-blank-at-eof
scripts/reconstruction/historical/*.py whitespace=-blank-at-eof
scripts/text/semantic_subset_config_v3.py whitespace=-blank-at-eof
# Recovered FineDance files retain their normalized original EOF bytes.
scripts/finedance/*.py whitespace=-blank-at-eof
